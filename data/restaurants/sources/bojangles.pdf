ion:a,id:77321,code:a},{name:"2026_BOX_HEROES_Ohio",description:"Heroes Day is our way of saying thank you to the heroes in our community. Every Tuesday in March, first responders, nurses, military members, and other everyday heroes can enjoy a free biscuit of their choice, available in-store and in the app at Heath, Columbus, Delaware and Circleville stores.",id:77636,code:a,channel:h,channel_name:i,campaign:"j29O3tq",campaign_name:"PR Campaign"},{name:"2026_Catering 10% off_RidgeView",description:bH,id:78000,code:a,channel:h,channel_name:i,campaign:"78NpWa8",campaign_name:"2026_10% off Catering_RidgeView"},{name:aGH,description:bH,id:78344,code:a,channel:h,channel_name:i,campaign:"8hsPFM2",campaign_name:aGH},{name:"2026_DST_IcedCoffee",description:"Get a FREE Any Iced Coffee with a $5 Minimum Purchase. To redeem, select a location, add Any Iced Coffee to your cart, and apply your offer at checkout. Hurry, offer is valid only for a limited time.",id:78371,code:a,channel:h,channel_name:i,campaign:"yY7AoJv",campaign_name:"Promo Window 2 DST"},{name:aGI,description:"Get 20% Off your Bo* purchase. To redeem, select a location, add item to your cart, and apply your offer at checkout. Valid at participating locations. ",id:78391,code:a,channel:h,channel_name:i,campaign:"7FmxGfK",campaign_name:aGI},{name:"2026_Charlotte FC_Free CFB",description:"CLTFC26 - Free Cajun Filet  Biscuit with CLTFC make a 2 goals",id:78689,code:a,channel:h,channel_name:i,campaign:"SYUHyoa",campaign_name:"Charlotte FC 2026 Season Offer"},{name:aGJ,description:a,id:78718,code:a,channel:h,channel_name:i,campaign:"btl5OCm",campaign_name:aGJ},{name:aGK,description:ek,id:79038,code:a,channel:h,channel_name:i,campaign:"ytog1cd",campaign_name:aGK},{name:"2026_Free Bo's Chicken Sandwich (BCS) Combo - #1131_GA Foods",description:aFt,id:79060,code:aFu,channel:h,channel_name:i,campaign:"3gKkalx",campaign_name:"Free Bo's Chicken Sandwich Combo - #1131"},{name:"2026_BOGO 4PC Bo's Chicken Rippers_Launch",description:"Buy One Get One Free 4PC Bo's Chicken Rippers. To redeem, select a location, add two 4PC Bo's Chicken Rippers to your cart, and apply your offer at checkout. Your discount will be deducted once applied.  Offer limited to one per user. Available at participating locations.",id:79064,code:a,channel:h,channel_name:i,campaign:"UDLawwL",campaign_name:"2026_BOGO 4PC Bo's Chicken Rippers_Launch_GE Launch Offer"},{name:aGL,description:"Buy One Get One Free 4PC Bo's Chicken Rippers. Valid thru 6\u002F7. To redeem, select a location, add two 4PC Bo's Chicken Rippers to your cart, and apply your offer at checkout. Your discount will be deducted once applied.  Offer limited to one per user. Available after 6pm & at participating locations.",id:79068,code:a,channel:h,channel_name:i,campaign:"c0PtFvJ",campaign_name:aGL},{name:"2026_$2 Off 4pc Bo's Chicken Rippers Combo",description:"Get $2 Off Bo's Chicken Rippers Combo (after 6pm). To redeem, select a location, add a Bo's Chicken Rippers Combo to your cart, and apply your offer at checkout.",id:79073,code:a,channel:h,channel_name:i,campaign:"QtWLsDR",campaign_name:"2026_$2 Off Bo's Chicken Rippers Combo"},{name:aGM,description:"$25 off after purchasing $150. To redeem, select a location, add a $150 order to your cart to redeem $25 off, and apply your offer at checkout. Your discount will be deducted once applied.  Offer limited to one per user. Available at participating locations.",id:79075,code:a,channel:h,channel_name:i,campaign:"tK54mny",campaign_name:aGM},{name:aGN,description:"Free Strawberry Cobbler with purchase of any combo. Valid between 4\u002F3-4\u002F5. To redeem, select a location, add a Bo's Chicken Rippers Combo to your cart, and apply your offer at checkout.",id:79081,code:a,channel:h,channel_name:i,campaign:"p9An6QZ",campaign_name:aGN},{name:"2026_25% off Family Meals_Easter Promotion",description:"25% off Family Meals (12pc & 20pc only). To redeem, select a location, add Family Meal to your cart, and apply your offer at checkout. Not valid with any other discounts, offers or special promotions. Offer limited to one per user. Available at participating locations.",id:79092,code:a,channel:h,channel_name:i,campaign:"gnN6fpu",campaign_name:"2026_25% off Family Meals_Easter Sunday"},{name:aGO,description:"Get a FREE 12 pack of Bo-Berry Biscuits with your order of $100+ with Bojangles Catering. Valid 4\u002F3-4\u002F5. To redeem, select a location, add items to your cart of $100 or more, and apply your offer at checkout.",id:79093,code:a,channel:h,channel_name:i,campaign:"zPeOENg",campaign_name:aGO},{name:aGP,description:"Buy One Get One FREE Triple Double Biscuit Sandwiches. To redeem, select a location, add TWO Triple Double Biscuit Sandwiches to your cart, and apply your offer at checkout. Available at participating NC & SC stores only.",id:79819,code:a,channel:h,channel_name:i,campaign:"GDNyeTf",campaign_name:aGP},{name:"2026_BFAY Q1 Winners_Biscuit Combo",description:fw,id:79827,code:a,channel:h,channel_name:i,campaign:"kMUkoNI",campaign_name:"Free Breakfast for a Year_2026_Q1"},{name:"2026_GreatCoverUp_$1_TenderSnack",description:"Hand-Breaded Crunch. Carolina Flavor.  Get a 3pc Tenders Snack for $1. Add a 3pc Tenders snack to your cart and apply the offer \u002Fpromo code at checkout.\r\n\r\nNo cash value. Not valid with any other discounts, offers or special promotions. Offer limited to one per user. Tax not included. No substitutions.",id:80135,code:a,channel:h,channel_name:i,campaign:"f9xDCEb",campaign_name:"GCU_Promocode"},{name:aGQ,description:"Buy One Get one FREE Bojangler Fish Sandwiches. To redeem, select a location, add TWO Bojangler Sandwiches to your cart, and apply your offer at checkout. Available at participating locations only.",id:80152,code:a,channel:h,channel_name:i,campaign:"udvVdbX",campaign_name:aGQ},{name:"2026_BOGO 4PC Bo's Chicken Rippers Combo_JoeWo\u002FPepsi",description:"Buy One Get One Free 4PC Bo's Chicken Rippers Combo. To redeem, select a location, add two 4PC Bo's Chicken Rippers Combos to your cart, and apply your offer at checkout. Your discount will be deducted once applied.  Offer limited to one per user. Available at participating locations.",id:80174,code:a,channel:h,channel_name:i,campaign:"t6esvuA",campaign_name:"2026_BOGO 4PC Bo's Chicken Rippers Combo_JoeWo\u002FPepsi_JOEWO"},{name:"2026_BOJ of WNC_Spartanburgers Free Bo Berry Biscuit",description:aGv,id:80177,code:a,channel:h,channel_name:i,campaign:"THdedhs",campaign_name:"2026_BOJ of WNC_Spartanburgers Free Bo-Berry Biscuit"},{name:"2026_FREE 4PC Bo's Chicken Rippers Combo_JoeWo\u002FPepsi  ",description:"Free 4PC Bo's Chicken Rippers Combo. To redeem, select a location, add one 4PC Bo's Chicken Rippers Combos to your cart, and apply your offer at checkout. Your discount will be deducted once applied.  Offer limited to one per user. Available at participating locations.",id:80489,code:a,channel:h,channel_name:i,campaign:"IDHKzxO",campaign_name:"2026_FREE 4PC Bo's Chicken Rippers Combo_JoeWo\u002FPepsi"},{name:"2026_25% Off 20pc Bo's Chicken Rippers_Panthers Draft Day",description:"Get 25% Off 20pc Bo's Chicken Rippers Combo. To redeem, select a location, add a 20pc Bo's Chicken Rippers Combo to your cart, and apply your offer at checkout.",id:80490,code:a,channel:h,channel_name:i,campaign:"1IDlZ8i",campaign_name:"2026_25% Off 20pc Bo's Chicken Rippers_Panthers Draft Day_RIPPERS25"},{name:"2026_Free Iced Coffee",description:"FREE Any Iced Coffee. To redeem, select a location, add Any Iced Coffee to your cart, and apply your offer at checkout.",id:80500,code:a,channel:h,channel_name:i,campaign:"sMbeXvT",campaign_name:"2026_Free Iced Coffee_Customer Recovery_BOJ store only"},{name:"2026_Free Grilled Chicken Sandwich",description:"FREE Grilled Chicken Sandwich. To redeem, select a location, add a Grilled Chicken Sandwich to your cart, and apply your offer at checkout.",id:80501,code:a,channel:h,channel_name:i,campaign:"kGsK2Ik",campaign_name:"2026_Free Grilled Chicken Sandwich_Customer Recovery"},{name:"2026_Catering 10% off_First Presbyterian Academy",description:ek,id:80913,code:a,channel:h,channel_name:i,campaign:"ZvxCeJy",campaign_name:yv},{name:aGR,description:ek,id:81236,code:a,channel:h,channel_name:i,campaign:"U8C6qdx",campaign_name:aGR},{name:aGS,description:ek,id:81292,code:a,channel:h,channel_name:i,campaign:"2loXBvN",campaign_name:aGS},{name:aGT,description:aGu,id:81295,code:a,channel:h,channel_name:i,campaign:"2yRNCPP",campaign_name:aGT},{name:aGU,description:"Get a FREE Biscuit Sandwich with any purchase $2 or more. To redeem, select a location, add anything $2+ and the biscuit sandwich of your choice to your cart, and apply MAYBISCUITS offer at checkout. Valid at participating locations. ",id:81613,code:a,channel:h,channel_name:i,campaign:"FaEEh3p",campaign_name:aGU},{name:"2026_Free_Biscuit_$2min",description:"Free biscuit sandwich with $2 Minimum Purchase. To redeem, select a location, add item to your cart, and apply your offer at checkout.",id:81614,code:a,channel:h,channel_name:i,campaign:"pRkb0FH",campaign_name:"MayBiscuitMonth_Week1"},{name:"2025_Asheville Tourists_Free Bo-Berry Biscuit (BOJ WNC)",description:"Get a FREE Bo-Berry Biscuit. To redeem, select a location, add Bo-Berry Biscuit to your cart, and apply promo code TOURISTS at checkout.",id:81626,code:a,channel:h,channel_name:i,campaign:"M9vdzPh",campaign_name:"2025_Asheville Tourists_Free Bo-Berry Biscuit (BOJ WNC)_TOURISTS"},{name:"Customer Recovery - Free Biscuit Combo",description:a,id:81667,code:a,channel:h,channel_name:i,campaign:"bmwNDwm",campaign_name:"Customer Recovery - Free Tenders Combo"},{name:"2026_$5off_10_Pack_Biscuit_Sandwiches",description:" Get a $5 OFF a 10 Pack Biscuit Sandwiches in Catering menu.\r\n To redeem, select a location, add a  10 Pack Biscuit Sandwiches in Catering menu to your cart, and apply your offer at checkout.",id:81679,code:a,channel:h,channel_name:i,campaign:"750oSlK",campaign_name:aGV},{name:"2026_Biscuit Month_20%off_2+Biscuit Sandwiches",description:"20% off 2+biscuit sandwiches. To redeem, select a location, add biscuit sandwiches to your cart, and apply your offer at checkout. Your discount will be deducted once applied. Available at participating locations.",id:81680,code:a,channel:h,channel_name:i,campaign:"Gqv1Ave",campaign_name:aGV},{name:aGW,description:yj,id:81986,code:a,channel:h,channel_name:i,campaign:"GCWS408",campaign_name:aGW},{name:"2026_BOGO_Biscuit_Combo",description:yu,id:82033,code:a,channel:h,channel_name:i,campaign:"TqL9K1F",campaign_name:"May Biscuit Week 3"},{name:aGX,description:"Get a FREE 12 pack of Bo-Berry Biscuits on Bojangles Catering. To redeem, select a location, add 12 pack Bo-Berry Biscuits to your cart, and apply your offer at checkout.",id:82045,code:a,channel:h,channel_name:i,campaign:"y2kSrgd",campaign_name:aGX},{name:"2026_Freesweet_Biscsandcombo",description:"Get a FREE dessert biscuit when you order a sandwich combo before 5\u002F31. Tax not included. No substitutions. Valid for Order Ahead and Curbside on www.bojangles.com and the Bojangles App at participating Bojangles Restaurants while supplies last.",id:82461,code:a,channel:h,channel_name:i,campaign:"VLCkOWS",campaign_name:"2026_May_Biscuit_Week4"},{name:"2026_BOJ Summer Offers_Tues BOGO 3pc Supremes Combo_SUPTUES",description:"Buy One Get one FREE 3pc Chicken Supremes Combo. To redeem, select a location, add TWO 3pc Chicken Supremes Combos to your cart, and apply your offer at checkout. Valid through 8\u002F28 & at participating locations only.",id:83359,code:a,channel:h,channel_name:i,campaign:"Xyv58tp",campaign_name:"2026_BOJ Summer Offers_Tues BOGO Supremes_SUPTUES"},{name:aGY,description:"Buy One Get one FREE 3pc Tenders Combo. To redeem, select a location, add TWO 3pc Tenders Combos to your cart, and apply your offer at checkout. Valid through 8\u002F28 & at participating locations only.",id:83362,code:a,channel:h,channel_name:i,campaign:"qZIi7qB",campaign_name:aGY},{name:aGZ,description:"Cajun Filet Biscuit + Large Iced Tea for $4.99. To redeem, select a location, add one Cajun Filet Biscuit and one Large Iced Tea to your cart, and apply your offer at checkout. Valid through 8\u002F28 & at participating locations only.",id:83369,code:a,channel:h,channel_name:i,campaign:"gEBhAsP",campaign_name:aGZ},{name:"2026_BOJ Summer Offers_Thurs Free Large Iced w\u002F $2 min purch_THURSTEA",description:"Get a FREE Large Iced Tea with a $2 Minimum Purchase. To redeem, select a location, add any Iced Coffee to your cart, and apply your offer at checkout. Valid through 8\u002F28 & .",id:83376,code:a,channel:h,channel_name:i,campaign:"ZFYczpm",campaign_name:"2026_BOJ Summer Offers_Thurs Free Large Iced Tea w\u002F $2 min purch_THURSTEA"},{name:aG_,description:"Get a FREE Cobbler with a $2 Minimum Purchase. To redeem, select a location, add any Cobbler to your cart, and apply your offer at checkout. Valid through 8\u002F28 & at participating locations only.",id:83383,code:a,channel:h,channel_name:i,campaign:"KGUpm9F",campaign_name:aG_},{name:aG$,description:"Get a FREE Cajun Filet Biscuit with a $1 Minimum Purchase. To redeem, select a location, add a Cajun Filet Biscuit to your cart with another item totaling over $1, and apply your offer at checkout. Valid through 8\u002F3 & at participating locations only.",id:83644,code:a,channel:h,channel_name:i,campaign:"9dcH39u",campaign_name:aG$},{name:aHa,description:a,id:83645,code:a,channel:h,channel_name:i,campaign:"4nUHiGn",campaign_name:aHa}],walletOffers:{},topBanner:aDb,orderConfirming:n,shouldOpenConfirmLocationModal:n,locationConfirmModalShownInSession:n,confirmLocationModalSection:a,miniLoading:n,headerHeight:a,footerHeight:a,createAccount:e,guestUser:a,homepageCarouselContentCards:[],homepageTopAlertContentCards:[],offerScreenContentCards:[],offerToApply:a,activeOrder:a,globalClass:a,showCateringConfigOrder:n,cateringMinTimeOrder:e,channel:O,activeSku:a,language:"en-US",stateSearch:a,deeplinkProduct:a,deeplinkProductQuery:a,deeplinkProductNotFoundAtLocation:n,showBorderlessOverlay:n,borderlessOverlayEmail:a,showCompleteProfileModal:n,savedDetailsOnCheckout:n,forms:{}},serverRendered:n,routePath:yw,config:{_app:{basePath:s,assetsPath:"\u002F_nuxt\u002F",cdnURL:a}}}}(null,void 0,"","location",true,"NC","product-image",381,"App Signup","asset","North Carolina","SC","GA",false,"redirect","VA","South Carolina","TN","\u002F","mobile-webapp-customize","desktop-menu","mobile-webapp-menu","Georgia","desktop-customize","marketplace-product","calorie-count","product","Charlotte",382,"Wisely Email","multilink","link","Tennessee","story","AL","Virginia","60b46a82-eed9-4955-b179-048e9c42c710","order\u002F","TX","Alabama","default","Raleigh","Columbia","FL","Greensboro","Begin Your Order","Greenville","card","Fayetteville","Knoxville","Durham","Jacksonville","Order Now","Spartanburg","Lexington","Richmond","Florida","Rocky Mount","Goldsboro","Wilmington","Hickory","Winston Salem","Concord","responsive-large","product-category","Huntsville","Myrtle Beach","NV","Athens","Gastonia","Asheville","home",43722318,"(704) 527-2675","Florence","Cary","Marion","Clinton","KY","Augusta","Fort Mill","OH","Anderson","MD","Burlington","Rock Hill","Rome","Texas","page","301","Get a FREE Bo's Chicken Sandwich. To redeem, select a location, add Bo's Chicken Sandwich to your cart, and apply your offer at checkout.","Get a FREE Cajun Filet Biscuit. To redeem, select a location, add Cajun Filet Biscuit to your cart, and apply your offer at checkout.","Get a FREE Sausage Biscuit. To redeem, select a location, add Sausage Biscuit to your cart, and apply your offer at checkout.","Canton","Cleveland","Monroe","Columbus","Wilson","Memphis",420,"CAJUN","Nashville","Store","50935fff-b5ce-4afb-9ea3-5d17f7952fd7",2295755,"https:\u002F\u002Fstoryblok.pleinaircdn.com\u002Ff\u002F110020\u002Fx\u002F094a633ca5\u002Fbjoa_camobigboboxvfx_001_cc-1440x700.mp4","hero-slide","Camobig BoBox®","hero","Camo or not, it’s hard to overlook this limited-edition Big Bo Box. Feed your troops with 8 pieces of perfectly seasoned chicken, plus biscuits, fixins and tea. Only at Bojangles.",2295756,"https:\u002F\u002Fstoryblok.pleinaircdn.com\u002Ff\u002F110020\u002Fx\u002Fe116a48e03\u002Fbjoa_camobigboboxvfx_001_cc-375x650.mp4","565716f2-6995-4560-bfb5-672b2a7bf13a","Download the Bojangles app today for exclusive offers and the easiest way  to skip the line with Bo-To-Go™.",10192710,"https:\u002F\u002Fstoryblok.pleinaircdn.com\u002Ff\u002F110020\u002F550x373\u002F7f6d4d14fe\u002F_generic_website-app-offer-module_phone-sunburst.png","https:\u002F\u002Fapps.apple.com\u002Fapp\u002Fid1564685788","order-ahead","Get the Bojangles App Yet?","https:\u002F\u002Fplay.google.com\u002Fstore\u002Fapps\u002Fdetails?id=org.pleinair.bojanglesmobile",10192711,"https:\u002F\u002Fstoryblok.pleinaircdn.com\u002Ff\u002F110020\u002F600x102\u002F5fac8623db\u002Fmrktsd-2248-2023_01_generic_website-app-offer-module_bo-time-lockup.png","6758abe7-aee1-4de6-becb-d4b368eb3b59","We’re serving up our signature hand breaded chicken tenders.",11105910,"https:\u002F\u002Fstoryblok.pleinaircdn.com\u002Ff\u002F110020\u002F750x472\u002F74e976b4e3\u002Fhand-breaded-tenders.png","HAND BREADED TENDERS","The menu features the best of Bojangles, including handbreaded Bo’s Chicken Tenders, Bo’s Chicken Sandwich and scratch-made biscuits served at breakfast and with every Family Meal, as well as our Legendary Iced Tea.",9243859,"https:\u002F\u002Fstoryblok.pleinaircdn.com\u002Ff\u002F110020\u002F379x321\u002F097f0c40e3\u002Fgroup-1365.png","THE BEST OF BOJANGLES","7e8ad4e9-b0af-44d4-890d-d2a061c774da","Marinated with a bold blend of seasonings and served on a made-from-scratch buttermilk biscuit with Bo-Tato Rounds® and a drink. The one that puts the \"famous\" in our famous chicken and biscuits.",9243860,"https:\u002F\u002Fstoryblok.pleinaircdn.com\u002Ff\u002F110020\u002F380x321\u002F3a2f44e069\u002Fgroup-1364.png","PERFECTLY FLUFFY AND GOLDEN BISCUITS","promo-slider","Order Fried Chicken Now","Get famous chicken and biscuits however you want it. Drive-thru, delivery, order ahead, or dine-in.",370981727,"2021-05-11T21:20:18.000Z","Get 10% Off your Bo* Catering purchase. To redeem, select a location, add item to your cart, and apply your offer at checkout. Valid at participating locations. ","Virginia Beach","Atlanta","Bristol","Hendersonville","Clarksville","Salisbury","Sanford","Greer","Aiken","Marietta","Madison","Kinston","Statesville","High Point","Orangeburg","Shelby","Chattanooga","Roanoke",0,50365530,"url","32f96110-f910-4a64-a765-2466b2b77a73","5dbca305-01f2-4517-9818-850705d747ab","18cc77e5-8c73-4bd5-a413-83f08f5ce4fc","fbcf02e3-85d5-4bc6-b9c6-8b3b758b6eaa","Fuel your tailgate with a Big Bo Box filled with hand-breaded chicken, scratch-made biscuits and real Southern fixins. Order before kickoff in the Bojangles app!",12155244,"https:\u002F\u002Fstoryblok.pleinaircdn.com\u002Ff\u002F110020\u002Fx\u002F709c5dbaac\u002Fmrktsd-2596-2023_07_tailgate_homepageslider_desktop_r6_expansion.mp4",10499000,"https:\u002F\u002Fstoryblok.pleinaircdn.com\u002Ff\u002F110020\u002Fx\u002Fedb095244e\u002Ftailgate-lockup.svg","Tailgate",12155243,"https:\u002F\u002Fstoryblok.pleinaircdn.com\u002Ff\u002F110020\u002Fx\u002F7e4edeb866\u002Fmrktsd-2596-2023_07_tailgate_homepageslider_mobile_r8_expansion.mp4","BoTime","Get a FREE Cajun Filet Biscuit. To redeem, select a location, add Cajun Filet Biscuit to your cart, and apply your offer at checkout. Your discount will be deducted once applied. If you have trouble, use BUSSIN as the promo code at checkout. ","MS","LA","Las Vegas","Henderson","Fountain beverage by PepsiCo.","menu","Chester","Conway","Kannapolis","Piedmont","West Columbia","Kentucky",597,280,"#000000","media","Free Bo's Chicken Biscuit","Hampton","Suffolk","Waynesville","Daleville","Apex","Newport","Valdosta","Farmville","Lynchburg","South Bosto