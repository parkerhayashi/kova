# Copy to .env.local and fill in. Never commit real values.
# Everything here is server-only except the NEXT_PUBLIC_ Supabase pair.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session-pooler connection string, used by `npm run db:push` / `db:check`.
SUPABASE_DB_URL=

# --- App access ---------------------------------------------------------------
# Single-user password gate (the app runs open without it — set it in every deployment).
KOVA_PASSWORD=
# HMAC key for session cookies (falls back to KOVA_PASSWORD).
AUTH_SECRET=
# Bearer token Vercel Cron sends to /api/sync/*. Required in production.
CRON_SECRET=
# Encrypts stored OAuth tokens (Oura, Plaid).
TOKEN_ENCRYPTION_KEY=

# --- Garmin Connect Personal API (runs, rides, strength, sleep, HRV, weight) ---
GARMIN_API_KEY=

# --- Hevy (lifting) -----------------------------------------------------------
HEVY_API_KEY=
HEVY_WEBHOOK_SECRET=

# --- Oura (retired Nov 2026; kept for history / re-connecting) ----------------
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=

# --- Nutrition ----------------------------------------------------------------
USDA_API_KEY=
# Claude — meal photo capture and the daily cut coach.
ANTHROPIC_API_KEY=

# --- Muse (AI assistant connector) --------------------------------------------
# Bearer token for /api/muse/*; use a long random value.
MUSE_API_TOKEN=

# --- Plaid (finances module, hidden by default) ------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
